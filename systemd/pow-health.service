[Unit]
Description=Check PowPowPow collector and data freshness
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/powpowpow
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/bash -lc 'set -uo pipefail; /usr/bin/python3 scripts/pipeline_status.py || true; exec /usr/bin/python3 scripts/health_check.py'
TimeoutStartSec=180
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/powpowpow/warehouse /root/powpowpow/chains /root/.local/state/powpowpow
UMask=0077
