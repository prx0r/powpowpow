[Unit]
Description=PowPowPow QUBIC epoch engine
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/powpowpow
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 scripts/qubic_epoch.py
TimeoutStartSec=300
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/powpowpow/warehouse /root/powpowpow/chains
UMask=0077
