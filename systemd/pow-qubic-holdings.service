[Unit]
Description=PowPowPow QUBIC holdings — exchange reserves and wealth concentration
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/root/powpowpow
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=POW_MIN_FREE_BYTES=2147483648
ExecStart=/usr/bin/python3 collectors/qubic_holdings.py --cadence 300 --concentration-every 72
Restart=always
RestartSec=15
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/powpowpow/warehouse /root/powpowpow/chains
UMask=0077

[Install]
WantedBy=default.target
