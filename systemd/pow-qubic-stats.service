[Unit]
Description=PowPowPow QUBIC official stats (tick quality, active addresses, burns)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/root/powpowpow
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=POW_MIN_FREE_BYTES=2147483648
ExecStart=/usr/bin/python3 collectors/qubic_stats.py --cadence 300 --rich-list-every 12
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/powpowpow/warehouse /root/powpowpow/chains
UMask=0077

[Install]
WantedBy=default.target
