[Unit]
Description=PowPowPow verified Cloudflare R2 synchronization (upload only)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/powpowpow
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/bash -lc 'set -euo pipefail; export CF_ACCOUNT_ID="$(agent-vault vault credential get CLOUDFLARE_ACCOUNT_ID --vault oracle)"; export CF_R2_ACCESS_KEY="$(agent-vault vault credential get CLOUDFLARE_R2_ACCESS_KEY --vault oracle)"; export CF_R2_SECRET_KEY="$(agent-vault vault credential get CLOUDFLARE_R2_SECRET_KEY --vault oracle)"; export CLOUDFLARE_R2_ENDPOINT="$(agent-vault vault credential get CLOUDFLARE_R2_ENDPOINT --vault oracle)"; /usr/bin/python3 scripts/r2_upload.py --dir /root/powpowpow/warehouse --remote powpowpow --bucket powpowpow-warehouse --min-age-minutes 10 --workers 4; exec /usr/bin/python3 scripts/r2_upload.py --dir /root/powpowpow/chains --remote powpowpow/chains --bucket powpowpow-warehouse --min-age-minutes 10 --workers 2 --state-file ~/.local/state/powpowpow/r2-chains.json --lock-file ~/.local/state/powpowpow/r2-chains.lock'
TimeoutStartSec=infinity
TimeoutStopSec=120
Nice=10
IOSchedulingClass=idle
MemoryHigh=512M
MemoryMax=768M
OOMScoreAdjust=500
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/powpowpow/warehouse /root/powpowpow/chains /root/.local/state/powpowpow
UMask=0077
